<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AssemblyName>Jellyfin.Plugin.SubtitleRewind</AssemblyName>
    <RootNamespace>Jellyfin.Plugin.SubtitleRewind</RootNamespace>
    <Version>1.0.0.0</Version>
    <Authors>Mohammed Saahir Essa</Authors>
    <Product>Jellyfin Subtitle Rewind</Product>
    <Description>Automatically turns on subtitles for 60 seconds when skipping back up to 90 seconds to catch missed dialogue, reverting seamlessly with zero UI disruption.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Jellyfin.Controller" Version="10.9.0" />
    <PackageReference Include="Jellyfin.Model" Version="10.9.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Web\**\*" />
  </ItemGroup>
</Project>
